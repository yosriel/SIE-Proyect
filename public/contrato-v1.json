{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni-SI Falabella · Gateway local simulado",
    "version": "1.0.0",
    "description": "Contrato de transporte del prototipo. El adaptador JavaScript traduce Idempotency-Key a clave. Las rutas se ejecutan dentro del navegador."
  },
  "paths": {
    "/api/v1/estado": {
      "get": {
        "operationId": "leerEstado",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9-]{8,64}$"
            },
            "example": "00000001"
          }
        ],
        "responses": {
          "200": {
            "description": "Existencias y estados de pedidos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "stock",
                    "pedidos",
                    "correlacion"
                  ],
                  "properties": {
                    "stock": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Existencia"
                      }
                    },
                    "pedidos": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "estado": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "correlacion": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "correlacion": "00000001",
                  "stock": {
                    "Tienda A": {
                      "fisico": 10,
                      "reservado": 2,
                      "cuarentena": 0
                    },
                    "Tienda B": {
                      "fisico": 0,
                      "reservado": 0,
                      "cuarentena": 0
                    },
                    "CD Lima": {
                      "fisico": 18,
                      "reservado": 0,
                      "cuarentena": 0
                    }
                  },
                  "pedidos": [
                    {
                      "id": "PED-DEMO",
                      "estado": "Entregado"
                    },
                    {
                      "id": "PED-VENCIDO",
                      "estado": "Entregado"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Clave o cuerpo inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Ruta desconocida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Método no admitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Clave reutilizada para un cuerpo diferente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Regla de negocio incumplida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "x-politica-local": "Acceso de demostración en el mismo navegador. Sin cuota de solicitudes configurada."
      }
    },
